{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "bin/**/*",
    "test/**/*",
    "public/js/**/*"
  ],
  "exclude": [
    "node_modules",
    "public/vendor/**/*"
  ]
}
